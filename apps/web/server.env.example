# Copy this file to apps/web/server.env and edit the values before deployment.
SNAPTEX_PROJECTS_ROOT=/srv/snaptex/projects
SNAPTEX_INSTALL_DIR=/opt/snaptex-web
SNAPTEX_SERVICE_NAME=snaptex-web
# Created automatically when missing. The installer grants scoped project ACLs.
SNAPTEX_RUN_USER=snaptex
HOST=localhost
PORT=3000
# The web UI can override this per request. Auto probes TinyTeX first, then latexmk.
SNAPTEX_PDF_COMPILER=tinytex
# Optional: absolute path when latexmk is not on the service account's PATH.
# SNAPTEX_LATEXMK=/usr/bin/latexmk
# Optional: absolute path when Rscript is not on the service account's PATH.
# SNAPTEX_RSCRIPT=/usr/bin/Rscript
SNAPTEX_AUTH_USERNAME=snaptex-admin
SNAPTEX_AUTH_PASSWORD=replace-with-a-long-random-password
SNAPTEX_PUBLIC_ORIGIN=https://snaptex.example.com
SNAPTEX_PUBLIC_PATH=/
